<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Thème ARM Holding — Mode cosmique sombre -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">#d4a843</item>
        <item name="colorPrimaryDark">#05020c</item>
        <item name="colorAccent">#d4a843</item>
        <item name="android:windowBackground">#05020c</item>
        <item name="android:statusBarColor">#05020c</item>
        <item name="android:navigationBarColor">#05020c</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#05020c</item>
        <item name="android:windowBackground">#05020c</item>
        <item name="android:statusBarColor">#05020c</item>
        <item name="android:navigationBarColor">#05020c</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>